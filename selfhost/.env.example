# ============================================================
# Supabase Self-Host - Environment Variables
# ============================================================
# Copy to .env and fill in. NEVER commit the real .env.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# --- JWT ---
# 40+ random characters. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_at_least_40_chars_long_random_string_xxxxxxxx

# --- API Keys (generate from JWT_SECRET) ---
#
# Use the JWT generator at https://supabase.com/docs/guides/self-hosting/docker#api-keys
# OR run this Node.js snippet locally after setting JWT_SECRET:
#
#   npm i -g jsonwebtoken
#   node -e "const jwt=require('jsonwebtoken'); \
#     console.log('ANON:', jwt.sign({role:'anon',iss:'supabase',iat:1700000000,exp:2000000000}, process.env.JWT_SECRET)); \
#     console.log('SERVICE:', jwt.sign({role:'service_role',iss:'supabase',iat:1700000000,exp:2000000000}, process.env.JWT_SECRET));"
#
ANON_KEY=eyJ...PASTE_GENERATED_ANON_KEY
SERVICE_ROLE_KEY=eyJ...PASTE_GENERATED_SERVICE_ROLE_KEY

# --- Realtime ---
# Generate: openssl rand -base64 64
SECRET_KEY_BASE=CHANGE_ME_64_chars_random_string_for_realtime_xxxxxxxxxxxxxxxx

# --- Site ---
SITE_URL=https://yourdomain.ir
ADDITIONAL_REDIRECT_URLS=https://yourdomain.ir/**

# --- SMTP (for auth emails like password reset / confirmation) ---
SMTP_HOST=smtp.yourprovider.ir
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.ir
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@yourdomain.ir
SMTP_SENDER_NAME=فروشگاه شما
