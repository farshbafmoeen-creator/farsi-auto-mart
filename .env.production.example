# =====================================================
# Production environment variables for the TanStack app
# =====================================================
# Copy to .env.production on the server and fill in.
# These values point the app at your self-hosted Supabase.

# --- Supabase (client-visible) ---
VITE_SUPABASE_URL=https://yourdomain.ir/supabase
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...ANON_KEY_FROM_SELFHOST_ENV
VITE_SUPABASE_PROJECT_ID=selfhosted

# --- Supabase (server-only) ---
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLISHABLE_KEY=eyJ...ANON_KEY_FROM_SELFHOST_ENV
SUPABASE_SERVICE_ROLE_KEY=eyJ...SERVICE_ROLE_KEY_FROM_SELFHOST_ENV

# --- Email (SMTP) ---
SMTP_HOST=smtp.yourprovider.ir
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.ir
SMTP_PASS=your_smtp_password
SMTP_FROM="فروشگاه شما <noreply@yourdomain.ir>"
ADMIN_NOTIFY_EMAIL=admin@yourdomain.ir

# --- Site ---
SITE_URL=https://yourdomain.ir
NODE_ENV=production
PORT=3000
